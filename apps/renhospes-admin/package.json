{
  "name": "renhospes-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/**/*.{vue,ts}",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "src/**/*.{vue,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@iconify/vue": "^5.0.0",
    "@monorepo/composables": "workspace:*",
    "@monorepo/layout-template": "workspace:*",
    "@monorepo/mocks": "workspace:*",
    "@monorepo/request": "workspace:*",
    "@monorepo/types": "workspace:*",
    "@monorepo/ui-kit": "workspace:*",
    "@monorepo/utils": "workspace:*",
    "@tanstack/vue-query": "^5.99.2",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/extension-text-align": "^3.23.1",
    "@tiptap/extension-text-style": "^3.23.1",
    "@tiptap/extension-underline": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "@tiptap/vue-3": "^3.23.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.15.1",
    "dayjs": "^1.11.20",
    "element-plus": "^2.13.7",
    "pinia": "^3.0.4",
    "qiankun": "^2.10.0",
    "qrcode": "^1.5.4",
    "msw": "^2.7.0",
    "tiptap-extension-resize-image": "^1.4.0",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.4",
    "vite-plugin-eslint": "^1.8.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
